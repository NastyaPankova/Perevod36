@page "/reports/getReportsByPeriod"
@using System.Net.Http.Json
@using Perevod36.Client.Shared.Dto.Orders
@inject HttpClient Http

<div class="container mt-4">
    <div class="card shadow-sm p-4 mb-4">
        <h3 class="mb-3 text-primary">Заказы за период</h3>
        <div class="row align-items-center g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text">С</span>
                    <input type="date" class="form-control" @bind-value="FromDate" @bind-value:event="onchange" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text">По</span>
                    <input type="date" class="form-control" @bind-value="ToDate" @bind-value:event="onchange" />
                </div>
            </div>
            <div class="col-md-4">
                <button type="button" class="btn btn-primary d-flex align-items-center justify-content-center w-100" @onclick="FetchOrdersAsync">
                    <i class="bi bi-arrow-clockwise me-2" style="font-size: 1.1rem;"></i> Обновить
                </button>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (Data == null || !Data.Orders.Any())
    {
        <div class="alert alert-info text-center">
            Заказов за выбранный период не найдено
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="p-3 bg-light border rounded">
                    <h5>Период: <span class="text-secondary">@FromDate.ToString("dd.MM.yyyy") — @ToDate.ToString("dd.MM.yyyy")</span></h5>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-success text-white border rounded">
                    <h5>Сумма заказов за период: <strong>@Data.Total.ToString("C")</strong></h5>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover border">
                <thead class="table-light">
                    <tr>
                        <th>Номер заказа</th>
                        <th>Дата создания</th>
                        <th>Документ для перевода</th>
                        <th>Стоимость заказа</th>
                        <th>Кол-во страниц</th>
                        <th>Заказчик</th>
                        <th>Менеджер</th>
                        <th>Переводчик</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Data.Orders)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                <a href="getOrderById/@order.Id" class="text-primary text-decoration-none-hover">
                                    @order.OrderNumber
                                </a>
                            </td>
                            <td>@order.Created.ToString("dd.MM.yyyy")</td>
                            <td>@order.TranslationTypeName</td>
                            <td>@order.Cost.ToString("C")</td>
                            <td>@order.NumberOfPages</td>
                            <td>@order.Customer</td>
                            <td>@order.Manager</td>
                            <td>@order.Translator</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DateTime FromDate { get; set; } = DateTime.UtcNow.Date;
    private DateTime ToDate { get; set; } = DateTime.UtcNow.Date;
    private ReportsByPeriodDto? Data { get; set; }
    private bool IsLoading { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await FetchOrdersAsync();
    }

    private async Task FetchOrdersAsync()
    {
        IsLoading = true;
        try
        {
            string from = FromDate.ToString("yyyy-MM-dd");
            string to = ToDate.ToString("yyyy-MM-dd");

            var url = $"/api/v1/reports/getReportsByPeriod?fromDate={from}&toDate={to}";

            Data = await Http.GetFromJsonAsync<ReportsByPeriodDto>(url);
        }
         catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке данных: {ex.Message}");
            Data = null;
        }
        finally
        {
            IsLoading = false;
        }
    }
}