@page "/getOrdersByUser"
@using System.Net.Http.Json
@using System.Net
@using Perevod36.Client.Shared.Dto.Orders
@inject HttpClient Http

<div class="container mt-4">
    <div class="card shadow-sm p-4 mb-4">
        <h3 class="mb-3 text-primary">Поиск заказов по Email</h3>
        <div class="d-flex gap-2">
            <input type="email" class="form-control" placeholder="Введите email пользователя..."
                   @bind="Email" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button type="button" class="btn btn-primary px-4" @onclick="FetchOrdersAsync" disabled="@string.IsNullOrWhiteSpace(Email)">
                Найти
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }

    else
    {
        if (IsUserNotFound)
        {
            <div class="alert alert-danger text-center shadow-sm">
                Пользователь с Email <strong>@SearchedEmail</strong> не найден
            </div>
        }
        else
        {
            if (Orders != null && !Orders.Any())
            {
                <div class="alert alert-info text-center shadow-sm">
                   Заказы не найдены
                </div>
            }
            else
            {
                <div class="mb-3">
                    <h4>Результаты поиска для: <span class="text-primary">@Orders.FirstOrDefault().Customer</span></h4>
                </div>

                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-hover table-striped border m-0">
                        <thead class="table-dark">
                            <tr>
                                <th>№ Заказа</th>
                                <th>Дата создания</th>
                                <th>Тип перевода</th>
                                <th>Менеджер</th>
                                <th>Переводчик</th>
                                <th class="text-center">Страниц</th>
                                <th class="text-end">Стоимость</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Orders)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@order.OrderNumber</td>
                                    <td>@order.Created.ToString("dd.MM.yyyy")</td>
                                    <td>@order.TranslationTypeName</td>
                                    <td>@order.Manager</td>
                                    <td>@order.Translator</td>
                                    <td class="text-center">@order.NumberOfPages</td>
                                    <td class="text-end fw-bold text-secondary">@order.Cost.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    //email в процессе ввода
    private string? Email { get; set; }
    //email фактически введеный
    private string? SearchedEmail { get; set; } 
    //предварительная инициализация orders пустым списком, иначе падает
    private List<OrderDto> Orders { get; set; } = new List<OrderDto>();
    private bool IsLoading { get; set; } = false;
    private bool IsUserNotFound { get; set; } = false;

    private async Task FetchOrdersAsync()
    {
        if (string.IsNullOrWhiteSpace(Email)) return;

        IsLoading = true;
        IsUserNotFound = false;
        Orders = null;
        SearchedEmail = Email.Trim();

        try
        {
            //формирование номального email из введенной строки (замена спец символов, пробелы и т.д.) для сетевых протоколов 
            var email = Uri.EscapeDataString(SearchedEmail);
            var url = $"/api/v1/reports/getOrdersByUser?email={email}";
            var response = await Http.GetAsync(url);

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                IsUserNotFound = true;
            }
            else if (response.IsSuccessStatusCode)
            {
                Orders = await response.Content.ReadFromJsonAsync<List<OrderDto>>() ?? new List<OrderDto>();
            }
            else
            {
                Console.WriteLine($"Произошла ошибка: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Произошла ошибка: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FetchOrdersAsync();
        }
    }
}