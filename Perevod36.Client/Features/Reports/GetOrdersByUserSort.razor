@page "/getOrdersByUserSort"
@using System.Net.Http.Json
@using System.Net
@using Perevod36.Client.Shared.Dto.Orders
@inject HttpClient Http

<div class="container mt-4">
    <div class="card shadow-sm p-4 mb-4">
        <h3 class="mb-3 text-primary">Поиск заказов по Email</h3>
        <div class="d-flex gap-2">
            <input type="email" class="form-control" placeholder="Введите email пользователя..."
                   @bind="Email" @bind:event="oninput" @onkeyup="HandleKeyUp" />
            <button type="button" class="btn btn-primary px-4" @onclick="FetchOrdersAsync" disabled="@string.IsNullOrWhiteSpace(Email)">
                Найти
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        if (IsUserNotFound)
        {
            <div class="alert alert-danger text-center shadow-sm">
                Пользователь с Email <strong>@SearchedEmail</strong> не найден
            </div>
        }
        else
        {
            if (Orders != null && !Orders.Any())
            {
                <div class="alert alert-info text-center shadow-sm">
                    Заказы не найдены
                </div>
            }
            else
            {
                <div class="mb-3">
                    <h4>Результаты поиска для: <span class="text-primary">@Orders.FirstOrDefault()?.Customer</span></h4>
                </div>

                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-hover table-striped border m-0">
                        <thead class="table-dark">
                            <tr>
                                <th @onclick="@(() => SortTable("OrderNumber"))" style="cursor: pointer; user-select: none;">
                                    № Заказа @GetSortArrow("OrderNumber")
                                </th>
                                <th @onclick="@(() => SortTable("Created"))" style="cursor: pointer; user-select: none;">
                                    Дата создания @GetSortArrow("Created")
                                </th>
                                <th @onclick="@(() => SortTable("TranslationTypeName"))" style="cursor: pointer; user-select: none;">
                                    Тип перевода @GetSortArrow("TranslationTypeName")
                                </th>
                                <th @onclick="@(() => SortTable("Manager"))" style="cursor: pointer; user-select: none;">
                                    Менеджер @GetSortArrow("Manager")
                                </th>
                                <th @onclick="@(() => SortTable("Translator"))" style="cursor: pointer; user-select: none;">
                                    Переводчик @GetSortArrow("Translator")
                                </th>
                                <th @onclick="@(() => SortTable("NumberOfPages"))" class="text-center" style="cursor: pointer; user-select: none;">
                                    Страниц @GetSortArrow("NumberOfPages")
                                </th>
                                <th @onclick="@(() => SortTable("Cost"))" class="text-end" style="cursor: pointer; user-select: none;">
                                    Стоимость @GetSortArrow("Cost")
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in SortedOrders)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@order.OrderNumber</td>
                                    <td>@order.Created.ToString("dd.MM.yyyy")</td>
                                    <td>@order.TranslationTypeName</td>
                                    <td>@order.Manager</td>
                                    <td>@order.Translator</td>
                                    <td class="text-center">@order.NumberOfPages</td>
                                    <td class="text-end fw-bold text-secondary">@order.Cost.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    private string? Email { get; set; }
    private string? SearchedEmail { get; set; }
    private List<OrderDto> Orders { get; set; } = new List<OrderDto>();
    private bool IsLoading { get; set; } = false;
    private bool IsUserNotFound { get; set; } = false;

   
    private string currentSortColumn = "";
    private bool isAscending = true;

   
    private IEnumerable<OrderDto> SortedOrders
    {
        get
        {
            if (string.IsNullOrEmpty(currentSortColumn)) return Orders;

            return currentSortColumn switch
            {
                "OrderNumber" => isAscending ? Orders.OrderBy(o => o.OrderNumber) : Orders.OrderByDescending(o => o.OrderNumber),
                "Created" => isAscending ? Orders.OrderBy(o => o.Created) : Orders.OrderByDescending(o => o.Created),
                "TranslationTypeName" => isAscending ? Orders.OrderBy(o => o.TranslationTypeName) : Orders.OrderByDescending(o => o.TranslationTypeName),
                "Manager" => isAscending ? Orders.OrderBy(o => o.Manager) : Orders.OrderByDescending(o => o.Manager),
                "Translator" => isAscending ? Orders.OrderBy(o => o.Translator) : Orders.OrderByDescending(o => o.Translator),
                "NumberOfPages" => isAscending ? Orders.OrderBy(o => o.NumberOfPages) : Orders.OrderByDescending(o => o.NumberOfPages),
                "Cost" => isAscending ? Orders.OrderBy(o => o.Cost) : Orders.OrderByDescending(o => o.Cost),
                _ => Orders
            };
        }
    }

    
    private void SortTable(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            isAscending = !isAscending; 
        }
        else
        {
            currentSortColumn = columnName;
            isAscending = true; 
        }
    }


    private string GetSortArrow(string columnName)
    {
        if (currentSortColumn != columnName) return "↕";
        return isAscending ? "↑" : "↓";
    }

    private async Task FetchOrdersAsync()
    {
        if (string.IsNullOrWhiteSpace(Email)) return;

        IsLoading = true;
        IsUserNotFound = false;
        Orders = new List<OrderDto>(); 
        currentSortColumn = "";
        SearchedEmail = Email.Trim();

        try
        {
            var email = Uri.EscapeDataString(SearchedEmail);
            var url = $"/api/v1/reports/getOrdersByUser?email={email}";
            var response = await Http.GetAsync(url);

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                IsUserNotFound = true;
            }
            else if (response.IsSuccessStatusCode)
            {
                Orders = await response.Content.ReadFromJsonAsync<List<OrderDto>>() ?? new List<OrderDto>();
            }
            else
            {
                Console.WriteLine($"Произошла ошибка: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Произошла ошибка: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FetchOrdersAsync();
        }
    }
}