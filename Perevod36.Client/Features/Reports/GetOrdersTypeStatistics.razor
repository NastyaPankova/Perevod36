@page "/getOrdersTypeStatistics"
@using System.Net.Http.Json
@using Perevod36.Client.Shared.Dto.Orders
@inject HttpClient Http

<div class="container mt-4">
    <div class="card shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-start align-items-center">
            <h3 class="m-0 text-primary">Статистика по типам заказов</h3>
            <button type="button" class="btn btn-primary d-flex align-items-center ms-3" @onclick="FetchStatisticsAsync">
                <i class="bi bi-arrow-clockwise" style="font-size: 1.1rem;"></i>
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка....</span>
            </div>
        </div>
    }
    else if (Statistics == null || !Statistics.Any())
    {
        <div class="alert alert-info text-center">
            Данные о заказах отсутствуют
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped border m-0">
                <thead class="table-dark">
                    <tr>
                        <th>Тип документа</th>
                        <th class="text-center" style="width: 200px;">Количество заказов</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in Statistics)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">@stat.TranslationTypeName</td>
                            <td class="text-center">
                                <span class="badge bg-primary fs-6 px-3">@stat.OrderCount</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold border-top">
                    <tr>
                        <td>Всего заказов</td>
                        <td class="text-center fs-5 text-dark">@TotalOrdersCount</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    private List<OrdersTypeStatisticsDto>? Statistics { get; set; }
    private bool IsLoading { get; set; } = false;

    private int TotalOrdersCount => Statistics?.Sum(s => s.OrderCount) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await FetchStatisticsAsync();
    }

    private async Task FetchStatisticsAsync()
    {
        IsLoading = true;
        try
        {      
            Statistics = await Http.GetFromJsonAsync<List<OrdersTypeStatisticsDto>>("/api/v1/reports/getOrdersTypeStatistics");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке данных: {ex.Message}");
            Statistics = null;
        }
        finally
        {
            IsLoading = false;
        }
    }
}