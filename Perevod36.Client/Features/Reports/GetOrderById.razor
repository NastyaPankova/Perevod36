<!-- разные адреса для поиска и для заданного id -->
@page "/getOrderById"
@page "/getOrderById/{Id:int}"
@using System.Globalization
@using System.Net
@using System.Net.Http.Json
@using Perevod36.Client.Shared.Dto.Orders
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-4">
    @if (Id == null)
    {
        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
            <div class="card-header bg-primary text-white py-3">
                <h3 class="mb-0 fs-5">Поиск заказа</h3>
            </div>
            <div class="card-body p-4">
                <div class="input-group mb-3">
                    <!--  inputmode="numeric" - для скрытия букв на мобильной клавиатуре-->
                    <!-- oninput="this.value = this.value.replace(/[^0-9]/g, '')" - замена символов на цифры -->
                    <input type="text"
                           inputmode="numeric" 
                           oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                           class="form-control"
                           placeholder="Введите ID заказа"
                           @bind="SearchId"
                           @onkeyup="HandleKeyUp" />
                    <button class="btn btn-primary" type="button" @onclick="SearchOrder">Найти</button>
                </div>
               
            </div>
        </div>
    }
    else if (IsLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (IsOrderNotFound || Order == null)
    {
        <div class="alert alert-danger text-center shadow-sm" role="alert">
            Заказ с ID <strong>@Id</strong> не найден
        </div>
        <div class="text-center mt-3">
            <a href="getOrderById" class="btn btn-primary">К поиску заказа</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <h3 class="mb-0 fs-4">Заказ № @Order.OrderNumber</h3>
                <span class="badge bg-light text-primary fs-6">ID: @Order.Id</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h5 class="text-muted border-bottom pb-2 mb-3">Информация</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary">Заказчик:</span>
                                <span class="fw-semibold text-primary">@Order.Customer</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary">Дата создания:</span>
                                <span class="fw-semibold">@Order.Created.ToString("dd.MM.yyyy")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary">Тип перевода:</span>
                                <span class="fw-semibold text-end">@Order.TranslationTypeName</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary">Количество страниц:</span>
                                <span class="badge bg-secondary rounded-pill fs-6">@Order.NumberOfPages</span>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5 class="text-muted border-bottom pb-2 mb-3">Сотрудники</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary">Менеджер:</span>
                                <span class="fw-semibold">@Order.Manager</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-secondary">Переводчик:</span>
                                <span class="fw-semibold">@Order.Translator</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                <a href="getOrderById" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> К поиску заказа
                </a>
                <div class="fs-4">
                    <span class="text-secondary fs-5">Стоимость:</span>
                    <span class="text-success fw-bold">@Order.Cost.ToString("C", CultureInfo.GetCultureInfo("ru-RU"))</span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; } 

    private int? SearchId { get; set; }
    private OrderDto? Order { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsOrderNotFound { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        await FetchOrderByIdAsync();
    }

    private async Task FetchOrderByIdAsync()
    {
        if (Id == null)
        {
            Order = null;
            IsLoading = false;
            return;
        }

        IsLoading = true;
        IsOrderNotFound = false;
        Order = null;

        try
        {
            var url = $"/api/v1/reports/getOrderById/{Id}";
            var response = await Http.GetAsync(url);

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                IsOrderNotFound = true;
            }
            else if (response.IsSuccessStatusCode)
            {
                Order = await response.Content.ReadFromJsonAsync<OrderDto>();
            }
            else
            {
                Console.WriteLine($"Ошибка при загрузке заказа: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Исключение при получении данных: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SearchOrder()
    {
        if (SearchId.HasValue)
            Navigation.NavigateTo($"/getOrderById/{SearchId}");
        
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SearchOrder();
    }
}