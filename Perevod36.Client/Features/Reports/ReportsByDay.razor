@page "/reportsByDay"
@using System.Net.Http.Json
@using Perevod36.Client.Shared.Dto.Orders
@inject HttpClient Http

<div class="container mt-4">
    <div class="card shadow-sm p-4 mb-4">
        <h3 class="mb-3 text-primary">Заказы за день</h3>
        <div class="row align-items-center">
            <div class="col-md-4">
              
                <input type="date" class="form-control" @bind-value="SelectedDate" @bind-value:event="onchange" @onclosure="FetchOrdersAsync" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100" @onclick="FetchOrdersAsync">Обновить данные</button>
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else if (Data == null || !Data.Orders.Any())
    {
        <div class="alert alert-info text-center">
            Заказов на дату <strong>@SelectedDate.ToString("dd.MM.yyyy")</strong> не найдено.
        </div>
    }
    else
    {
       
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="p-3 bg-light border rounded">
                    <h5>Заказы от: <span class="text-secondary">@Data.Date</span></h5>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-success text-white border rounded">
                    <h5>Сумма заказов за день: <strong>@Data.Total.ToString("C")</strong></h5>
                </div>
            </div>
        </div>

        <h4 class="mb-3 text-secondary">Подробности</h4>

        <div class="table-responsive">
            <table class="table table-hover border">
                <thead class="table-light">
                    <tr>
                        <th>Номер заказа</th>
                        <th>Документ для перевода</th>
                        <th>Кол-во страниц</th>
                        <th>Стоимость заказа</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Data.Orders)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@order.OrderNumber</td>
                            <td><span class="badge bg-secondary">@order.TranslationTypeName</span></td>
                            <td>@order.NumberOfPages</td>
                            <td class="text-success fw-bold">@order.Cost.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DateTime SelectedDate { get; set; } = DateTime.UtcNow.Date;
    private OrdersByDayDto? Data { get; set; } 
    private bool IsLoading { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await FetchOrdersAsync();
    }

    private async Task FetchOrdersAsync()
    {
        IsLoading = true;
        try
        {
            string formattedDate = SelectedDate.ToString("yyyy-MM-dd");
            
            Data = await Http.GetFromJsonAsync<OrdersByDayDto>($"/api/v1/reports/reportsByDay/{formattedDate}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при загрузке данных: {ex.Message}");
            Data = null;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
